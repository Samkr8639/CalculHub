{
    "name": "myapp",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "fix-seo:dry": "node tools/seo-fixer.js --dry-run",
        "fix-seo": "node tools/seo-fixer.js --apply",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve:ssr:myapp": "node dist/myapp/server/server.mjs"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^21.2.13",
        "@angular/compiler": "^21.2.13",
        "@angular/core": "^21.2.13",
        "@angular/forms": "^21.2.13",
        "@angular/platform-browser": "^21.2.13",
        "@angular/platform-server": "^21.2.13",
        "@angular/router": "^21.2.13",
        "@angular/service-worker": "^21.2.13",
        "@angular/ssr": "^21.2.11",
        "@types/chart.js": "^2.9.41",
        "@types/mathjs": "^9.4.1",
        "algebra.js": "^0.2.6",
        "chart.js": "^4.5.1",
        "express": "^5.1.0",
        "gsap": "^3.13.0",
        "lucide-angular": "^0.567.0",
        "mathjs": "^15.1.0",
        "nerdamer": "^1.1.13"
    },
    "devDependencies": {
        "@angular/build": "^21.2.11",
        "@angular/cli": "^21.2.11",
        "@angular/compiler-cli": "^21.2.13",
        "@types/express": "^5.0.1",
        "@types/jasmine": "~5.1.0",
        "@types/node": "^20.17.19",
        "jasmine-core": "~5.9.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "typescript": "~5.9.2"
    }
}